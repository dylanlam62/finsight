DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deepagents

# OpenAI or any OpenAI-compatible endpoint
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.poe.com/v1

# Default model name (no provider prefix needed when using a custom base URL)
DEEPAGENT_MODEL=gpt-4o

# ScraperAPI — used by the market_research tool
# Get a key at https://www.scraperapi.com/
SCRAPER_API_KEY=

# Optional LangSmith tracing
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
